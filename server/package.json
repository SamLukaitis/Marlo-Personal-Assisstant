{
  "name": "personal-assistant-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "invite": "tsx src/scripts/invite.ts",
    "set-edition": "tsx src/scripts/setEdition.ts",
    "test": "vitest run",
    "eval:grounding": "vitest run --config vitest.eval.config.ts",
    "whatsapp:check": "tsx src/scripts/whatsappCheck.ts",
    "maps:probe": "tsx src/scripts/mapsProbe.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.5",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "better-sqlite3": "^11.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "countries-and-timezones": "^3.10.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "geo-tz": "^8.1.8",
    "googleapis": "^144.0.0",
    "libphonenumber-js": "^1.13.14",
    "luxon": "^3.7.2",
    "mammoth": "^1.12.2",
    "pdf-parse": "^2.4.5",
    "rss-parser": "^3.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "^22.10.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
