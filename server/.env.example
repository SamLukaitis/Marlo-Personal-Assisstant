PORT=4000
CLIENT_URL=http://localhost:5173
# The server's own public URL — used to build the magic links sent over WhatsApp during
# WhatsApp-native registration (a text message can't use a relative link). In production this is
# usually the same origin as CLIENT_URL; defaults to the local dev server's port otherwise.
SERVER_URL=http://localhost:4000
# Set to "production" on a real deployment (Railway etc.) — makes the session cookie Secure
# (HTTPS-only). Not required locally over http://localhost.
NODE_ENV=development

# --- Multi-tenancy: the very first migration run backfills all pre-existing data to one
# "app owner" account and auto-invites them, so you're never locked out of your own data.
# Defaults to samlukaitis5@gmail.com if unset — only needed if that's not the right address.
APP_OWNER_EMAIL=

# --- WhatsApp Simulator: a browser chat UI (admin-only) that drives the real inbound-message
# pipeline (registration, debounced batching, choice buttons) via a reserved fake number instead
# of a real WhatsApp number. Set to "true" on staging only — never on production — so testing new
# features can't collide with the real WhatsApp Business number's live conversations.
ENABLE_WHATSAPP_SIMULATOR=

# --- Admin Portal: grants an already-invited email admin access (the Portal, not the narrower
# owner-only Settings/Admin section) on every startup, without needing an existing admin to grant
# it through the Portal's Admins tab first. Optional — only needed to bootstrap the first admin
# besides the app owner. Safe to leave set indefinitely (re-applying is a no-op).
BOOTSTRAP_ADMIN_EMAIL=

# --- Google (Gmail + Calendar + Drive) ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (type: Web application)
# Authorized redirect URI must be: http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# --- Microsoft (Outlook mail + Calendar) — optional ---
# Azure Portal > App registrations > New registration
# Redirect URI (type Web): http://localhost:4000/auth/microsoft/callback
# Supported account types: personal + work/school ("common")
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:4000/auth/microsoft/callback

# --- WhatsApp (message your assistant via Meta's Cloud API) — optional ---
# Meta for Developers > your app > WhatsApp > API Setup (see README)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Make up any random string yourself — you enter the same value in Meta's webhook config
WHATSAPP_VERIFY_TOKEN=
# Meta for Developers > your app > Settings > Basic > App Secret
WHATSAPP_APP_SECRET=

# --- Location check-ins (phone automation → travel log, not via WhatsApp) ---
# Make up any random string yourself. A phone automation (iOS Shortcuts / Android Tasker)
# POSTs to /api/checkin with this value plus latitude/longitude when you land somewhere.
CHECKIN_SECRET=

# --- Encryption at rest (OAuth tokens + uploaded documents) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes) for AES-256. Back this up somewhere safe outside
# the server — losing it makes every encrypted token/document permanently unreadable.
ENCRYPTION_KEY=

# --- Claude (the AI assistant) ---
# console.anthropic.com > API keys
ANTHROPIC_API_KEY=
# The assistant picks per-message between a cheap tier (lookups/summaries) and a richer tier
# (drafting, judgment calls, multi-step reasoning) — see "Cost efficiency" in the README.
# Optional: override either tier's model.
# ASSISTANT_MODEL_SIMPLE=claude-haiku-4-5
# ASSISTANT_MODEL_COMPLEX=claude-sonnet-5

# --- Google Maps (optional: nearby places + driving/walking times) ---
# Google Cloud console > enable "Maps Grounding Lite API" on a billing-enabled project >
# Credentials > API key, restricted to that API. Set a daily quota as a cost backstop.
# Leave blank to disable — Marlowe then falls back to web search for places.
GOOGLE_MAPS_API_KEY=

# Marlowe Shortcut (phone actions). Leave blank to turn the feature off.
# iCloud link of the published "Marlowe" Shortcut — see docs/marlowe-shortcut-build-guide.md.
MARLOWE_SHORTCUT_ICLOUD_URL=
# The version the published Shortcut sends in X-Marlowe-Shortcut: 1 = the nine core steps, 2 = all steps.
MARLOWE_SHORTCUT_VERSION=1

# --- Joyce (the family assistant, on her own WhatsApp number) ---
# Joyce is a separate product sharing this server: see server/src/joyce/ and
# feature-to-do/joyce-family-assistant.md. Her data lives in data/joyce/, never in app.db.
#
# The phone number id is Joyce's own and must differ from WHATSAPP_PHONE_NUMBER_ID above — it is
# what tells her messages apart from Marlowe's when both numbers sit on one Meta app.
JOYCE_WHATSAPP_PHONE_NUMBER_ID=
# Anything you like; set the same value as the Verify Token on Joyce's webhook in Meta.
JOYCE_WHATSAPP_VERIFY_TOKEN=
# Both optional — they fall back to Marlowe's WHATSAPP_TOKEN / WHATSAPP_APP_SECRET, which is
# correct when Joyce's number is in the same WhatsApp Business Account. Set them only if she is
# on a separate Meta app.
# JOYCE_WHATSAPP_TOKEN=
# JOYCE_WHATSAPP_APP_SECRET=
#
# The root of every family's encryption key. Generate a NEW one — it must not be the same value
# as ENCRYPTION_KEY above:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Each family's key is derived from this plus a per-family salt, and is never stored anywhere.
# Losing this makes every family's data permanently unreadable. Back it up off the server.
JOYCE_MASTER_KEY=
# Optional: override the model Joyce uses (defaults to claude-sonnet-5, same as Marlowe's
# richer tier).
# JOYCE_MODEL=claude-sonnet-5
